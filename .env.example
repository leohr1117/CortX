# HTTP port. Default 3100.
PORT=3100

# SQLite file. Default data/cortex.db.
CORTX_DB=data/cortex.db

# Built client folder the server serves. Default ../cortx-betrieb/dist-live (live). Build and e2e set client/dist.
# CORTX_CLIENT_DIST=client/dist

# Internal Stride sign-in URL. Default http://127.0.0.1:3000/api/zugang.
CORTX_STRIDE_URL=http://127.0.0.1:3000/api/zugang

# Public Stride origin for the change-password page. Default https://stride.leohr.de.
CORTX_STRIDE_PUBLIC_URL=https://stride.leohr.de

# Log level. Default warn.
LOG_LEVEL=warn
